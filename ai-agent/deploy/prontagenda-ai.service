[Unit]
Description=Prontagenda AI Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=prontagenda-ai
Group=prontagenda-ai
WorkingDirectory=/opt/prontagenda-ai/app
EnvironmentFile=/opt/prontagenda-ai/.env
ExecStart=/opt/prontagenda-ai/venv/bin/uvicorn gateway:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/prontagenda-ai/data

[Install]
WantedBy=multi-user.target
